<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TableConverter.ViewModels.Tools"
             xmlns:controls="clr-namespace:TableConverter.Views.Controls"
             xmlns:property="clr-namespace:TableConverter.Views.Controls.PropertyGrid"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:DataGenerationOptionsViewModel"
             x:Class="TableConverter.Views.Tools.DataGenerationOptionsView">
    <DockPanel>
        <controls:CommandButtonToolBar DockPanel.Dock="Bottom">
            <controls:CommandButtonToolBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
            </controls:CommandButtonToolBar.ItemsPanel>
        </controls:CommandButtonToolBar>
        <property:PropertyGrid Item="{Binding Options, Mode=TwoWay}">
            <property:PropertyGrid.DataTemplates>
                <property:PropertyGridTemplateSelector />
            </property:PropertyGrid.DataTemplates>
        </property:PropertyGrid>
    </DockPanel>
</UserControl>
