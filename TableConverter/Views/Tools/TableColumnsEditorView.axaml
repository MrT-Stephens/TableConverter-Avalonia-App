<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TableConverter.ViewModels.Tools"
             xmlns:controls="clr-namespace:TableConverter.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:TableColumnsEditorViewModel"
             x:Class="TableConverter.Views.Tools.TableColumnsEditorView">
    <DockPanel>
        <controls:CommandButtonToolBar DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Commands="{Binding ColumnCommands, Mode=OneWay}">
            <controls:CommandButtonToolBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"
                                 ColumnSpacing="10" />
                </ItemsPanelTemplate>
            </controls:CommandButtonToolBar.ItemsPanel>
        </controls:CommandButtonToolBar>
        <ListBox Grid.IsSharedSizeScope="True"
                 SelectionMode="Multiple"
                 SelectedItems="{Binding SelectedColumns, Mode=TwoWay}"
                 ItemsSource="{Binding Columns, Mode=OneWay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"
                                              SharedSizeGroup="IndexGroup" />
                            <ColumnDefinition Width="*"
                                              SharedSizeGroup="NameGroup" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Text="{Binding Item.Id, Mode=OneWay}">
                        </TextBlock>
                        <TextBox Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Text="{Binding Item.Name, Mode=TwoWay}">
                        </TextBox>
                        <TextBox Grid.Column="2"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   Text="{Binding Item.DefaultValueForCell, Mode=TwoWay}">
                        </TextBox>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
