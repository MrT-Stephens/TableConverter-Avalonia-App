<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TableConverter.ViewModels.Tools"
             xmlns:controls="clr-namespace:TableConverter.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:TableColumnsEditorViewModel"
             x:Class="TableConverter.Views.Tools.TableColumnsEditorView">
    <DockPanel>
        <controls:CommandButtonToolBar DockPanel.Dock="Top"
                                       Margin="0,0,0,10"
                                       Commands="{Binding ColumnCommands, Mode=OneWay}">
            <controls:CommandButtonToolBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"
                                 ColumnSpacing="10"
                                 RowSpacing="10" />
                </ItemsPanelTemplate>
            </controls:CommandButtonToolBar.ItemsPanel>
        </controls:CommandButtonToolBar>
        <TreeDataGrid Source="{Binding TreeDataSource, Mode=OneWay}" />
        <Border DockPanel.Dock="Bottom"
                Margin="0,10,0,0"
                Padding="10,6"
                IsVisible="{Binding HasColumnStatistics, Mode=OneWay}"
                Background="{DynamicResource SukiBackgroundShade}">
            <TextBlock Text="{Binding StatisticsSummary, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </DockPanel>
</UserControl>
