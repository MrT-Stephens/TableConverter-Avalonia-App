<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TableConverter.ViewModels.Tools"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TableConverter.Views.Tools.ValidationView"
             x:DataType="viewModels:TableValidationViewModel">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="10">
        <!-- The check belongs to the panel rather than to the workspace menu, so it is a plain button
             rather than one of the workspace's command instances. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Command="{Binding CheckCommand, Mode=OneWay}"
                    IsEnabled="{Binding !IsChecking, Mode=OneWay}"
                    Content="Check this table" />
            <ProgressBar Grid.Column="1"
                         Height="4"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsChecking, Mode=OneWay}" />
        </Grid>

        <!-- What the last check found, in a sentence short enough to sit above the list. -->
        <TextBlock Grid.Row="1"
                   Classes="Caption"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasReport, Mode=OneWay}"
                   Text="{Binding Summary, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Classes="Caption"
                           TextWrapping="Wrap"
                           IsVisible="{Binding !HasReport, Mode=OneWay}"
                           Text="Open a table to check its values against the types of its columns." />

                <!-- Only the columns that hold something faulty are listed, each with the values that do
                     not read as its type and a button that jumps the grid to the row holding one. -->
                <ItemsControl ItemsSource="{Binding Columns, Mode=OneWay}"
                              IsVisible="{Binding HasProblems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:ValidationColumnViewModel">
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    CornerRadius="4"
                                    Background="{DynamicResource SukiBackgroundShade}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Header, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="Caption"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding CountLabel, Mode=OneWay}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Cells, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ValidationCellViewModel">
                                                <Button Classes="Flat"
                                                        Padding="6,4"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding JumpCommand, Mode=OneWay}">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">
                                                        <TextBlock Grid.Column="0"
                                                                   MinWidth="70"
                                                                   Classes="Caption"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding RowLabel, Mode=OneWay}" />
                                                        <TextBlock Grid.Column="1"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Value, Mode=OneWay}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Classes="Caption"
                                               IsVisible="{Binding IsTruncated, Mode=OneWay}"
                                               Text="{Binding TruncatedLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
