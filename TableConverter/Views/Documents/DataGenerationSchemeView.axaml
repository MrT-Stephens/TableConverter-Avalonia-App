<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TableConverter.ViewModels.Documents"
             xmlns:sukiUiTheme="clr-namespace:SukiUI.Theme;assembly=SukiUI"
             xmlns:converters="clr-namespace:TableConverter.Converters"
             xmlns:extensions="clr-namespace:TableConverter.Extensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TableConverter.Views.Documents.DataGenerationSchemeView"
             x:DataType="viewModels:DataGenerationSchemaViewModel">
    <UserControl.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="4,8" />
        </Style>
    </UserControl.Styles>
    <DataGrid ItemsSource="{Binding Fields}"
              SelectionMode="Single"
              AutoGenerateColumns="False"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              ClipboardCopyMode="None">
        <DataGrid.Columns>
            <!-- Data Generation Field Name -->
            <DataGridTemplateColumn Header="Field Name"
                                    Width="Auto"
                                    MinWidth="200"
                                    CanUserSort="True"
                                    SortMemberPath="Name">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Name, Mode=OneWay}"
                                 Watermark="{Binding PlaceHolder, Mode=OneWay}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Data Generation Field Type -->
            <DataGridTemplateColumn Header="Field Type"
                                    CanUserSort="True"
                                    SortMemberPath="TypeName">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Classes="Flat"
                                Command="{Binding ((viewModels:DataGenerationSchemaViewModel)DataContext).SelectDataGenerationTypeButtonCommand, 
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding .}"
                                HorizontalAlignment="Left">
                            <StackPanel Spacing="10"
                                        Orientation="Horizontal">
                                <TextBlock Text="{Binding TypeName, Mode=OneWay}" />
                                <PathIcon Data="{StaticResource UpDownIcon}"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                          Height="18"
                                          Width="18" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Data Generation Field Options -->
            <DataGridTemplateColumn Header="Field Options"
                                    MinWidth="200"
                                    CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <ItemsControl
                            ItemsSource="{Binding Parameters, Mode=OneWay, 
                                Converter={x:Static converters:DataGenerationMethodToControlsConverter.Instance}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Data Generation Field Number of Blanks -->
            <DataGridTemplateColumn Header="Blanks Percentage"
                                    MinWidth="150"
                                    CanUserSort="True"
                                    SortMemberPath="BlankPercentage">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <NumericUpDown Minimum="0"
                                       Maximum="100"
                                       ParsingNumberStyle="Integer"
                                       FormatString="N0"
                                       Value="{Binding BlankPercentage, Mode=TwoWay}"
                                       Margin="5,0,5,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       VerticalContentAlignment="Center"
                                       sukiUiTheme:NumericUpDownExtensions.Unit="%" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Data Generation Field Remove -->
            <DataGridTemplateColumn Header="Remove/Add"
                                    MinWidth="175"
                                    CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Button Classes="Flat Icon"
                                    CommandParameter="{Binding .}"
                                    Command="{Binding ((viewModels:DataGenerationSchemaViewModel)DataContext).RemoveFieldButtonClickedCommand, 
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    VerticalAlignment="Center"
                                    sukiUiTheme:ButtonExtensions.Icon="{extensions:IconFactory Path=TrashIcon}">
                            </Button>
                            <Button Classes="Flat Icon"
                                    CommandParameter="{Binding .}"
                                    Command="{Binding ((viewModels:DataGenerationSchemaViewModel)DataContext).AddFieldButtonClickedCommand, 
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    VerticalAlignment="Center"
                                    sukiUiTheme:ButtonExtensions.Icon="{extensions:IconFactory Path=PlusIcon}">
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>