<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:documents="clr-namespace:TableConverter.ViewModels.Documents"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TableConverter.Views.Documents.TableDataView"
             x:DataType="documents:TableDataViewModel">
    <Grid RowDefinitions="*,Auto"
          RowSpacing="10">
        <TreeDataGrid Grid.Row="0"
                      Source="{Binding TreeDataSource, Mode=TwoWay}">
        </TreeDataGrid>
        <Grid Grid.Row="1" 
              ColumnDefinitions="*">
            <TextBlock HorizontalAlignment="Right">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Rows: {0:N0}, Columns: {1:N0}">
                        <Binding Path="DataSource.Collection.Count" />
                        <Binding Path="DataSource.ColumnCount" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
