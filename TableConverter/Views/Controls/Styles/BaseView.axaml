<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TableConverter.Views.Controls">
    <Style Selector=":is(views|BaseView)">
        <Setter Property="Theme" Value="{DynamicResource {x:Type views:BaseView}}" />
    </Style>
</Styles>