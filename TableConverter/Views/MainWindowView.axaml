<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                   xmlns:viewModels="clr-namespace:TableConverter.ViewModels"
                   xmlns:converters="clr-namespace:TableConverter.Converters"
                   xmlns:views="clr-namespace:TableConverter.Views"
                   mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                   x:Class="TableConverter.Views.MainWindowView"
                   x:DataType="viewModels:MainWindowViewModel"
                   Title="{Binding AppOptions.AppName, Mode=OneWay}"
                   BackgroundStyle="{Binding AppOptions.BackgroundStyle, Mode=OneWay}"
                   BackgroundAnimationEnabled="{Binding AppOptions.BackgroundAnimationEnabled, Mode=OneWay}"
                   BackgroundTransitionsEnabled="{Binding AppOptions.BackgroundTransitionEnabled, Mode=OneWay}"
                   CanFullScreen="True"
                   IsMenuVisible="{Binding !!SelectedWorkspace.MainCommands.Count, Mode=OneWay}">
    <sukiUi:SukiWindow.MenuItems>
        <Binding Path="SelectedWorkspace.MainCommands"
                 Converter="{x:Static converters:CommandInstancesToMenuItemsConverter.Instance}"
                 Mode="OneWay" />
    </sukiUi:SukiWindow.MenuItems>
    <sukiUi:SukiWindow.LogoContent>
        <PathIcon Data="{StaticResource TableIcon}"
                  Width="15"
                  Height="15"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource SukiPrimaryColor}">
            <PathIcon.Transitions>
                <Transitions>
                    <BrushTransition Property="Foreground" 
                                     Duration="{DynamicResource ShortAnimationDuration}" />
                </Transitions>
            </PathIcon.Transitions>
        </PathIcon>
    </sukiUi:SukiWindow.LogoContent>
    <views:MainContentView />
</sukiUi:SukiWindow>