{
  "AppOptions": {
    "AppName": "TableConverterPortable",
    "WorkingDirectory": "MyDocuments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Error"
    },
    "File": {
      "Path": "logs/{0:yyyy}-{0:MM}-{0:dd}.log",
      "Append": true,
      "MinLevel": "Trace",
      "FileSizeLimitBytes": 0,
      "MaxRollingFiles": 0
    }
  }
}