{
  "AppOptions": {
    "AppName": "TableConverter",
    "WorkingDirectory": "MyDocuments"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "System": "Trace",
      "Microsoft": "Trace"
    },
    "File": {
      "Path": "logs/{0:yyyy}-{0:MM}-{0:dd}.log",
      "Append": true,
      "MinLevel": "Trace",
      "FileSizeLimitBytes": 0,
      "MaxRollingFiles": 25
    }
  }
}