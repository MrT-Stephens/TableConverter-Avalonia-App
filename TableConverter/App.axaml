    <Application.Styles>
        <!-- Application Styles -->
        <sukiUi:SukiTheme ThemeColor="Green"  />
        
        <StyleInclude Source="Views/Controls/DockedToolPanel.axaml" />
        
        <Style Selector="DataValidationErrors">
            <Setter Property="ErrorTemplate">
                <DataTemplate x:DataType="{x:Type x:Object}">
                    <Canvas Width="14" 
                            Height="14" 
                            Margin="4 0 1 0" 
                            Background="Transparent"
                            ToolTip.Placement="Pointer">
                        <ToolTip.Tip>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={x:Static converter:DataErrorObjectToStringConverter.Instance}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ToolTip.Tip>
                        <Path Data="M14,7 A7,7 0 0,0 0,7 M0,7 A7,7 0 1,0 14,7 M7,3l0,5 M7,9l0,2" 
                              Stroke="Red" 
                              StrokeThickness="2" />
                    </Canvas>
                </DataTemplate>
            </Setter>
        </Style>
    </Application.Styles>
</Application>